<mujoco model="sphere_haptic_test">
  <option timestep="0.002"/>
  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 2" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba="0.3 0.3 0.3 1"/>

    <!-- Proxy: a real, dynamic, collidable body -->
    <body name="sphere" pos="0 0 0.05" gravcomp="1">
  <freejoint/>
  <geom name="sphere_geom" type="sphere" size="0.03" mass="0.05" rgba="0.2 0.6 1 1"/>
</body>

    <!-- Obstacle to push -->
    <body name="box" pos="0 -0.08 0.2">
      <geom name="box_geom" type="box" size="0.2 0.2 0.2" mass="0.2" rgba="0.8 0.2 0.2 1"/>
    </body>

    <!-- Device: driven directly from the real robot's TCP pose, no
         collision, no joint exactly like your existing mocap body -->
    <body name="mocap" mocap="true" pos="0 0 0.05">
      <geom type="sphere" size="0.01" contype="0" conaffinity="0" rgba="1 1 0 0.6"/>
    </body>
  </worldbody>
</mujoco>