<mujoco model="sphere_haptic_bunny_target">
  <compiler meshdir="/home/justinrc/workspace/src/dual_servo_ur3e_sim/mjcf/"/>
  <option timestep="0.002"/>

  <asset>
    <mesh name="bunny_mesh" file="bun_zipper_res2.stl" scale="2 2 2"/>
  </asset>

  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 2" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba="0.3 0.3 0.3 1"/>

    <!-- Dynamic Sphere Proxy (Driven by Mocap) -->
    <body name="sphere" pos="0 0 0.05" gravcomp="1">
      <freejoint/>
      <geom name="sphere_geom" type="sphere" size="0.03" mass="0.05" rgba="0.2 0.6 1 1"/>
    </body>

    <!-- Target Obstacle (Replaced Box with Bunny) -->
    <body name="bunny_target" pos="0 -0.08 0.2">
      <geom name="bunny_geom" type="mesh" mesh="bunny_mesh" mass="0.2" rgba="0.8 0.2 0.2 1"/>
    </body>

    <!-- Device Mocap Target -->
    <body name="mocap" mocap="true" pos="0 0 0.05">
      <geom type="sphere" size="0.01" contype="0" conaffinity="0" rgba="1 1 0 0.6"/>
    </body>
  </worldbody>
</mujoco>